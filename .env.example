# ==============================================================================
# Earth Temporal Intelligence - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Microsoft Planetary Computer STAC (Public Access - No API Key Required for Public Collections)
PC_STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PC_API_KEY=

# Google Earth Engine (Optional - Set if service account is configured)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# AI Earth Investigator Configuration (Optional - Falls back to internal curated geospatial knowledge bases)
OPENAI_API_KEY=
SERPAPI_API_KEY=

# Cache & Storage Directory
CACHE_DIR=./cache/satellite
OUTPUT_DIR=./cache/reports
