# ==============================================================================
# Earth Temporal Intelligence - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Microsoft Planetary Computer STAC (Public Access - No API Key Required for Public Collections)
PC_STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PC_API_KEY=

# Google Earth Engine (Optional - Set if service account is configured)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# AI Earth Investigator & LLM Providers (Optional - Falls back to internal benchmark knowledge base)
OPENAI_API_KEY=
GROQ_API_KEY=
LITELLM_API_KEY=
SERPAPI_API_KEY=

# Academic Research & Environmental News APIs (Optional - Public endpoints active without keys)
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=user@example.com
GUARDIAN_API_KEY=

# Cache & Storage Directory
CACHE_DIR=./cache/satellite
OUTPUT_DIR=./cache/reports
